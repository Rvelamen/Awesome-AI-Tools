---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import tools from '../../../data.json';
import { resolveIcon } from '../../lib/icons';
import { resolveShot } from '../../lib/shots';
import { addedDates } from '../../lib/dates';

export function getStaticPaths() {
  const categories = [...new Set(tools.flatMap((t) => t.category))];
  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      entries: tools.filter((t) => t.category.includes(category)),
    },
  }));
}

const { category, entries } = Astro.props;
const base = import.meta.env.BASE_URL;
const sortedEntries = [...entries].sort(
  (a, b) => (addedDates[b.id] ?? 0) - (addedDates[a.id] ?? 0),
);
const types = [...new Set(entries.map((t) => t.type).filter(Boolean))] as string[];
---

<Layout title={`${category} - Awesome AI Tools`} description={`${category}分类下的 AI 工具`} active={category}>
  <div class="page-head" data-default-content>
    <h1>{category}</h1>
    <p>共 {entries.length} 个工具</p>
  </div>
  <section class="filterable" data-default-content>
    <FilterBar types={types} />
    <div class="grid">
      {
        sortedEntries.map((tool) => (
          <ToolCard
            title={tool.title}
            description={tool.description}
            url={tool.url}
            image={resolveIcon(tool, base)}
            type={tool.type}
            added={addedDates[tool.id]}
            shot={resolveShot(tool, base)}
          />
        ))
      }
    </div>
  </section>
</Layout>
