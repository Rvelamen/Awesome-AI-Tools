---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FilterBar from '../components/FilterBar.astro';
import { tools, projects, catCounts } from '../lib/catalog';
import { resolveIcon } from '../lib/icons';
import { resolveShot } from '../lib/shots';
import { addedDates } from '../lib/dates';
import { loadRepoMeta } from '../lib/github';

const base = import.meta.env.BASE_URL;

const featuredTitles = [
  'ChatGPT', 'DeepSeek', 'Claude', 'Midjourney', 'Gemini',
  'Cursor', '豆包', '通义千问', '文心一言', '可灵AI',
  '即梦AI', 'Suno', 'HeyGen', 'Sora', 'Copilot',
];
const featured = featuredTitles
  .map((t) => tools.find((tool) => tool.title === t))
  .filter((t): t is (typeof tools)[number] => Boolean(t));

const featuredProjectTitles = [
  'Superpowers', 'vue-skills', 'Claude-Mem', 'ljg-skills',
  'frontend-design', '卡兹克.skill',
];
const featuredProjects = featuredProjectTitles
  .map((t) => projects.find((p) => p.title === t))
  .filter((p): p is (typeof projects)[number] => Boolean(p));

const recent = [...tools]
  .filter((t) => addedDates[t.id])
  .sort((a, b) => addedDates[b.id] - addedDates[a.id])
  .slice(0, 12);

const recentTypes = [...new Set(recent.map((t) => t.type).filter(Boolean))] as string[];

const projectMetas = await loadRepoMeta(featuredProjects.map((p) => p.url));

const categories = catCounts(tools);
---

<Layout title="Awesome AI Tools - AI 工具导航" active="__home">
  <div class="page-head" data-default-content>
    <h1>全球 AI 工具都在这里</h1>
    <p>收录 {tools.length} 个 AI 工具与 {projects.length} 个开源项目，覆盖 {categories.length} 个分类，持续更新</p>
  </div>

  <section class="featured" data-default-content>
    <div class="sec-head">
      <h2 class="section-title">精选工具</h2>
    </div>
    <div class="strip">
      {
        featured.map((tool, i) => (
          <ToolCard
            title={tool.title}
            description={tool.description}
            url={tool.url}
            image={resolveIcon(tool, base)}
            type={tool.type}
            badge={`#${i + 1}`}
            added={addedDates[tool.id]}
            compact
          />
        ))
      }
    </div>
  </section>

  <section class="featured" data-default-content>
    <div class="sec-head">
      <h2 class="section-title">开源项目精选</h2>
      <a class="more-link" href={`${base}projects/`}>进入开源项目栏目 →</a>
    </div>
    <div class="strip">
      {
        featuredProjects.map((project, i) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            url={project.url}
            image={resolveIcon(project, base)}
            type={project.type}
            badge={`#${i + 1}`}
            added={addedDates[project.id]}
            compact
            meta={projectMetas.get(project.url)}
          />
        ))
      }
    </div>
  </section>

  <section class="filterable" data-default-content>
    <div class="sec-head">
      <h2 class="section-title">最近收录</h2>
      <a class="more-link" href={`${base}recent/`}>查看全部 →</a>
    </div>
    <FilterBar types={recentTypes} />
    <div class="grid">
      {
        recent.map((tool) => (
          <ToolCard
            title={tool.title}
            description={tool.description}
            url={tool.url}
            image={resolveIcon(tool, base)}
            type={tool.type}
            added={addedDates[tool.id]}
            shot={resolveShot(tool, base)}
          />
        ))
      }
    </div>
  </section>
</Layout>
