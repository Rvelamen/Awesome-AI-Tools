---
import Layout from '../layouts/Layout.astro';
import ToolCard from '../components/ToolCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FilterBar from '../components/FilterBar.astro';
import { entries, isProject } from '../lib/catalog';
import { resolveIcon } from '../lib/icons';
import { resolveShot } from '../lib/shots';
import { addedDates } from '../lib/dates';
import { loadRepoMeta } from '../lib/github';

const base = import.meta.env.BASE_URL;

const recent = [...entries]
  .filter((t) => addedDates[t.id])
  .sort((a, b) => addedDates[b.id] - addedDates[a.id]);

const types = [...new Set(recent.map((t) => t.type).filter(Boolean))] as string[];
const projectMetas = await loadRepoMeta(
  recent.filter(isProject).map((t) => t.url),
);

const toolCount = recent.filter((t) => !isProject(t)).length;
const projectCount = recent.length - toolCount;

const DAY = 86400;
const formatDate = (ts: number) => {
  const now = new Date();
  const d = new Date(ts * 1000);
  const days = Math.floor(
    (new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime() -
      new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime()) /
      (DAY * 1000),
  );
  if (days <= 0) return '今天';
  if (days === 1) return '昨天';
  if (days <= 30) return `${days} 天前`;
  const md = `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  return d.getFullYear() === now.getFullYear() ? md : `${d.getFullYear()}-${md}`;
};
---

<Layout title="最近新增 - Awesome AI Tools" description="最新收录的 AI 工具与开源项目" active="__recent">
  <div class="page-head" data-default-content>
    <h1>最新收录</h1>
    <p>按收录时间排序，共 {recent.length} 条（工具 {toolCount} · 开源项目 {projectCount}）</p>
  </div>
  <section class="filterable" data-default-content>
    <FilterBar types={types} kinds={['tool', 'project']} />
    <div class="grid">
      {
        recent.map((entry) =>
          isProject(entry) ? (
            <ProjectCard
              title={entry.title}
              description={entry.description}
              url={entry.url}
              image={resolveIcon(entry, base)}
              type={entry.type}
              badge={formatDate(addedDates[entry.id])}
              added={addedDates[entry.id]}
              shot={resolveShot(entry, base)}
              meta={projectMetas.get(entry.url)}
            />
          ) : (
            <ToolCard
              title={entry.title}
              description={entry.description}
              url={entry.url}
              image={resolveIcon(entry, base)}
              type={entry.type}
              badge={formatDate(addedDates[entry.id])}
              added={addedDates[entry.id]}
              shot={resolveShot(entry, base)}
            />
          ),
        )
      }
    </div>
  </section>
</Layout>
